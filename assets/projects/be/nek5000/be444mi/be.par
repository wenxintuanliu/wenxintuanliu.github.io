[GENERAL]
startFrom=be0.f00084
stopAt = endTime
endTime = 600
variableDT = yes
targetCFL = 0.3
dt = 1.0e-03
writeControl = timeStep
writeInterval = 200000000000
dealiasing = yes

# --- 显式滤波设置 ---
filtering = explicit
filterWeight = 0.05
filterModes = 2

[PROBLEMTYPE]
# !!! 必须加回 heat，否则第一个标量（交通源）会被永远隐藏 !!!
# 注意：这里只需要定义到 scalar02，因为 heat 占了第一个位置
#equation = incompNS + heat + scalar01 + scalar02
equation = incompNS
stressFormulation = yes

[PRESSURE]
residualTol = 1e-06
residualProj = yes

[VELOCITY]
residualTol = 1e-07
density = 1.0
viscosity = -500.0

# ==========================================================
# Phase 1 修改：将下面所有的标量定义全部注释掉 (#)
# Nek5000 只有在看不到这些块的时候，才会真正跳过标量求解
# ==========================================================

## --- 变量 1 (交通源) ---
